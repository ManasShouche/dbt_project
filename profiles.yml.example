# Copy to ~/.dbt/profiles.yml for LOCAL dbt runs.
#
#     cp profiles.yml.example ~/.dbt/profiles.yml
#
# This is the local developer's file and stays gitignored. Deploying to dbt
# Projects on Snowflake uses dbt_projects_profiles.yml instead, which carries
# no credentials because the project runs under the invoking session.
#
# Key-pair auth, not password: on this account `externalbrowser` fails
# (390190, no SAML identity provider) and passwords go stale (390100).
# Register the public half with
#     ALTER USER <user> SET RSA_PUBLIC_KEY = '<key body>';
#
# Models read `target.database` rather than hardcoding one, so the same
# checkout runs against any target below without edits.

tpch_pipeline:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'transformer') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE', 'dbt_pipe') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'wh_transform') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA', 'dbt_manas') }}"
      threads: 4
      client_session_keep_alive: false

    # A second account goes here; switching is `--target prod` rather than an
    # edit to any model. Same shape as streaming/profiles.yml.
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT_PROD') }}"
      user: "{{ env_var('SNOWFLAKE_USER_PROD') }}"
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH_PROD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE_PROD', 'transformer') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE_PROD', 'dbt_pipe') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE_PROD', 'wh_transform') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA_PROD', 'dbt_manas') }}"
      threads: 4
      client_session_keep_alive: false

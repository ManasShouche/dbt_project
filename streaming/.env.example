# Copy to .env. Optional -- every value here has a default.
#
# Connection details are NOT here; they live in profiles.yml. This file only
# picks WHICH profile/target to use.

CONNECTOR_PROFILE=tpch_stream

# Overrides the profile's own `target:` when set.
# CONNECTOR_TARGET=dev

# Point at any profiles.yml, including the one dbt already uses -- the key
# names are dbt's, so ~/.dbt/profiles.yml resolves without translation.
# CONNECTOR_PROFILES_PATH=~/.dbt/profiles.yml

CONNECT_URL=http://localhost:8083

# --- Streams ------------------------------------------------------------
# One connector, many topics. Both lists are comma-separated and must agree:
# every topic needs a mapping, or rows land in a table nobody reads.
#
# All topics land in ONE schema -- the connector has a single
# snowflake.schema.name, taken from the profile.
#
# KAFKA_TOPICS=orders,users,payments
# KAFKA_TOPIC_TABLE_MAP=orders:ORDERS_STREAM,users:USERS_STREAM,payments:PAYMENTS_STREAM
# KAFKA_DLQ_TOPIC=dlq.streams
